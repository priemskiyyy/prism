{
  "name": "@priemskiyyy/prism-react",
  "version": "0.1.0",
  "description": "React and React Native hooks for typed Prism flag handles.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/prism.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/prism/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p ."
  },
  "keywords": [
    "feature-flags",
    "typescript",
    "prism"
  ],
  "peerDependencies": {
    "@priemskiyyy/prism": "^0.1.0",
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@priemskiyyy/prism": "workspace:*"
  },
  "dependencies": {
    "use-sync-external-store": "1.7.0"
  }
}
