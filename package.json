{
  "name": "prism-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:types": "pnpm lint:typescript",
    "test:conformance": "vitest run --testNamePattern='adapter conformance'",
    "test:integration": "vitest run --project integration --project integration-react",
    "test:package": "node scripts/verify-packages.mjs",
    "test:examples": "pnpm build && playwright test -c examples/playwright.config.ts",
    "bench": "vitest bench --run --config benchmarks/vitest.config.ts",
    "build:examples": "pnpm --filter example-react --filter example-vue --filter example-solid --filter example-svelte build",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm test:lint && pnpm lint:prettier && pnpm test:unit && pnpm test:package && pnpm build:examples",
    "check:release": "pnpm check && pnpm lint:docs && pnpm build:docs && pnpm verify:docs && pnpm --filter example-expo build && pnpm --filter example-expo build:native",
    "dev": "pnpm --filter example-react dev",
    "dev:server": "pnpm --filter example-server dev",
    "test:lint": "node scripts/verify-lint-rules.mjs",
    "dev:docs": "vitepress dev docs",
    "build:docs": "vitepress build docs && node scripts/build-demo.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "lint:docs": "vue-tsc --noEmit -p docs/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@priemskiyyy/simulcast": "0.4.0",
    "@priemskiyyy/simulcast-broadcast-channel": "0.4.0",
    "@priemskiyyy/prism": "workspace:*",
    "@priemskiyyy/prism-http": "workspace:*",
    "@priemskiyyy/prism-memory": "workspace:*",
    "@priemskiyyy/prism-react": "workspace:*",
    "@priemskiyyy/prism-simulcast": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@types/use-sync-external-store": "1.7.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-vue": "10.11.0",
    "fast-check": "4.10.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11",
    "zod": "4.6.5"
  }
}
